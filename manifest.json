{
  "manifest_version": 3,
  "name": "Gloss 网页翻译 (中/繁/英)",
  "version": "1.0.0",
  "description": "任意语言网页实时双语对照翻译，聚焦简体中文、繁體中文与 English，支持整页翻译、划词弹窗、Alt+悬停译与多引擎切换。",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "scripting",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "src/popup/popup.html?mode=sidepanel"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Gloss 网页翻译 (中/繁/英)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/shared/config.js",
        "src/content/dom-translator.js",
        "src/content/selection-ui.js",
        "src/content/index.js"
      ],
      "css": [
        "src/content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-page-translate": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "切换整页翻译 / 恢复原文"
    },
    "toggle-ai-sidebar": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "打开 / 关闭 Sider 风格 AI 侧边栏"
    }
  }
}
